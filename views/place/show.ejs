<% layout('/layout/boilerplate.ejs') -%>

    <body class="bg-light">
        <div class="row">
            <div class="col-12 col-md-8 offset-md-2">
                <div>
                    <!-- Place Details Card -->
                    <div class="card">
                        <div class="ratio ratio-16x9">
                            <img src="<%= place.image %>" class="card-img-top object-fit-cover"
                                alt="<%= place.title %>">
                        </div>
                        <div class="card-body">
                            <p class="card-text"> ₹<%= place.price?.toLocaleString("en-IN") %>/Per Day</p>
                            <h5 class="card-title"><b>
                                    <%= place.title %>
                                </b></h5>
                            <p class="card-text">
                                <%= place.description %>
                            </p>
                            <p class="card-text"><b><i>
                                        <%= place.location %>
                                    </i></b></p>
                            <p class="card-text"><b><i>
                                        <%= place.country %>
                                    </i></b></p>
                        </div>
                        <div class="card-footer d-flex justify-content-between">
                            <form action="/place/<%= place._id %>/edit" method="GET">
                                <button type="submit" class="btn btn-primary">Edit</button>
                            </form>
                            <form action="/place/<%= place._id %>?_method=DELETE" method="POST">
                                <button type="submit" class="btn btn-danger">Delete</button>
                            </form>
                        </div>
                    </div>


                    <div class="container">
                        <form action="/place/<%= place._id %>/reviews" method="POST" class="col col-8 offset-2 needs-validation" novalidate>
                            <div class="rating-container text-center">
                                <div class="rating-emoji">
                                    😀 😊 😐 🫩 😒
                                </div>
                                <h3 class="rating-title">How was your experience?</h3>
                                <div class="star-rating">
                                    <input type="radio" id="star5" name="review[rating]" value="5">
                                    <label for="star5" class="fas fa-star"></label>
                                    <input type="radio" id="star4" name="review[rating]" value="4">
                                    <label for="star4" class="fas fa-star"></label>
                                    <input type="radio" id="star3" name="review[rating]" value="3">
                                    <label for="star3" class="fas fa-star"></label>
                                    <input type="radio" id="star2" name="review[rating]" value="2">
                                    <label for="star2" class="fas fa-star"></label>
                                    <input type="radio" id="star1" name="review[rating]" value="1" required>
                                     
                                    <label for="star1" class="fas fa-star"></label>
                                    <div class="invalid-feedback">
                                        please rate your experience
                                    </div>
                                </div>
                                <div class="rating-feedback">
                                    <textarea class="form-control" rows="3" placeholder="Tell us about your experience"
                                        name="review[comment]" required></textarea>
                                        <div class="valid-feedback">
                                            Looks good!
                                        </div>
                                         <div class="invalid-feedback">
                                            please give us your feedback
                                        </div>
                                </div>
                                <button class="submit-rating">Submit Rating</button>

                            </div>
                        </form>
                    </div>

                    <% if (place.reviews && place.reviews.length> 0) { %>
                        <div class="container mt-5">
                            <h2 class="text-center mb-5">What Our Clients Say</h2>

                            <div class="row g-4 justify-content-center">
                                <% for (let review of place.reviews) { %>
                                    <div class="col-md-4 d-flex">
                                        <div class="card w-100 shadow-sm border-0 bg-light">
                                            <div
                                                class="card-body text-center d-flex flex-column justify-content-between p-4">


                                                <p class="card-text italic text-muted flex-grow-1">
                                                    "<%= review.comment %>"
                                                </p>
                                                <div class="mt-3">
                                                    <h6 class="card-title fw-bold mb-2">Rating: <%= review.rating %>
                                                            <span style="color: rgb(236, 160, 21);"><i
                                                                    class="bi bi-star-fill "></i></span>
                                                    </h6>
                                                    <div class="text-warning fs-5">
                                                        <%
                                                        let rating=review.rating; 
                                                        let fullStars=rating
                                                        let emptyStars = 5 - fullStars
                                                        %>


                                                            <% for(let i=0; i < fullStars; i++) { %>
                                                                <i class="bi bi-star-fill"></i>
                                                            <% } %>

                                                            <% for(let i = 0; i < emptyStars; i++) { %>
                                                                <i class="bi bi-star"></i>
                                                            <% } %>
                                                    </div>
                                                </div>

                                            </div>
                                        </div>
                                    </div>
                                    <% } %>
                            </div>
                        </div>
                        <% } %>


                </div>
            </div>
        </div>
    </body>