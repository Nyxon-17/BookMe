<% layout('/layout/boilerplate.ejs') -%>

    <body class="bg-light">
        <div class="row">
            <div class="col-12 col-md-8 offset-md-2">
                <div>
                    <!-- Place Details Card -->
                    <div class="card">
                        <div class="ratio ratio-16x9">
                            <img src="<%= place.image %>" class="card-img-top object-fit-cover"
                                alt="<%= place.title %>">
                        </div>
                        <div class="card-body">
                            <p class="card-text"> ₹<%= place.price?.toLocaleString("en-IN") %>/Per Day</p>
                            <h5 class="card-title"><b>
                                    <%= place.title %>
                                </b></h5>
                            <p class="card-text">
                                <%= place.description %>
                            </p>
                            <p class="card-text"><b><i>
                                        <%= place.location %>
                                    </i></b></p>
                            <p class="card-text"><b><i>
                                        <%= place.country %>
                                    </i></b></p>
                        </div>
                        <div class="card-footer d-flex justify-content-between">
                            <form action="/place/<%= place._id %>/edit" method="GET">
                                <button type="submit" class="btn btn-primary">Edit</button>
                            </form>
                            <form action="/place/<%= place._id %>?_method=DELETE" method="POST">
                                <button type="submit" class="btn btn-danger">Delete</button>
                            </form>
                        </div>
                    </div>

                    <!-- Leave a Review Form -->
                    <div class="card mt-3 p-3">
                        <h3>Leave a Review</h3>
                        <!-- FIXED: Corrected the closing EJS tag from %> to -%> or %> and removed the stray extra form tag -->
                        <form action="/place/<%= place._id %>/reviews" method="POST">
                            <div class="mb-3">
                                <label for="rating" class="form-label">Rating</label>
                                <input type="range" name="review[rating]" id="rating" min="1" max="5" class="form-range"
                                    required>
                            </div>
                            <div class="mb-3">
                                <label for="comment" class="form-label">Comment</label>
                                <textarea name="review[comment]" id="comment" class="form-control" rows="3"
                                    required></textarea>
                            </div>
                            <button type="submit" class="btn btn-primary">Submit</button>
                        </form>
                    </div>

                    <% if (place.reviews && place.reviews.length> 0) { %>
                        <div class="mt-3">
                            <h3>Customer Reviews</h3>
                            <% for (let review of place.reviews) { %>
                                <div class="card mb-2">
                                    <div class="card-body">
                                        <h5 class="card-title">Rating: <%= review.rating %> / 5</h5>
                                        <p class="card-text">
                                            <%= review.comment %>
                                        </p>
                                    </div>
                                </div>
                                <% } %>
                        </div>
                        <% } %>

                </div>
            </div>
        </div>
    </body>